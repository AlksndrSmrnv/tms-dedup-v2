{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tms-dedup-v2/schemas/pair_review.schema.json",
  "title": "PairReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_a_id", "test_b_id", "verdict", "confidence"],
  "properties": {
    "test_a_id": { "type": "string" },
    "test_b_id": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": [
        "LIKELY_DUPLICATE",
        "POSSIBLE_DUPLICATE",
        "RELATED_NOT_DUPLICATE",
        "NOT_DUPLICATE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "same_base_intent": { "type": "boolean", "default": false },
    "different_dimensions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "section_relation": {
      "type": "string",
      "enum": [
        "same_section",
        "same_feature_group",
        "cross_feature_group",
        "cross_business_variant",
        "unknown"
      ],
      "default": "unknown"
    },
    "explanation": { "type": "string", "default": "" }
  }
}
